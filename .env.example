# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Room Expiration Policies (in milliseconds)
# Default room idle/expiration time: 10 minutes (600,000 ms)
ROOM_TTL_MS=600000
# Hard maximum room lifetime: 1 hour (3,600,000 ms)
MAX_ROOM_LIFETIME_MS=3600000

# Security and Origin Control
# Comma-separated list of allowed origins. In production, provide the exact HTTPS domain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Limits
MAX_WS_MESSAGE_BYTES=16384
MAX_TEXT_LENGTH=4096
MAX_ROOMS=100

# Rate Limiting (per IP / connection)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ROOM_CREATES=10
RATE_LIMIT_MAX_JOINS=15
RATE_LIMIT_MAX_MESSAGES=60

# WebRTC STUN & TURN Relay Configuration (Milestone 6)
# STUN Servers (comma-separated). Defaults to Google public STUN if empty:
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN Servers (comma-separated) for NAT/firewall traversal fallback:
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=

# Option A: Ephemeral TURN credentials (RFC 5766 / Coturn HMAC-SHA1 shared secret)
# Generates short-lived credentials dynamically without exposing this root secret to clients:
TURN_SECRET=
TURN_TTL_SECONDS=86400

# Option B: Static TURN credentials (e.g., Metered or static TURN provider):
TURN_USERNAME=
TURN_CREDENTIAL=
